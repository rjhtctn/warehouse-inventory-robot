<?xml version="1.0"?>
<sdf version="1.12">
  <world name="warehouse">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.75 0.80 0.85 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.2 -1</direction><cast_shadows>false</cast_shadows></light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material></visual>
    </link></model>
    <model name="test_wall"><static>true</static><pose>2 0 0.5 0 0 0</pose><link name="wall">
      <collision name="wall_collision"><geometry><box><size>0.1 2 1</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>0.1 2 1</size></box></geometry><material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
